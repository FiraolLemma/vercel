DEBUG=True
SECRET_KEY=replace-this-with-a-random-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=

# Local Redis is only needed for Django Channels features.
REDIS_URL=redis://localhost:6379

# Optional locally; all three are required on Vercel for persistent uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
